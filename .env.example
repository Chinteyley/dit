# Optional and server-only. Without a key, /api/expand answers 503 and the app uses the on-device expander.
DIT_LLM_API_KEY=
# Optional OpenAI-compatible base URL. Default: https://api.fireworks.ai/inference/v1
DIT_LLM_BASE_URL=
# Optional model ID. Default: DEFAULT_MODEL in src/lib/expansion/provider.ts
DIT_MODEL=

# Server-only speech-to-text key for Listen's fallback (a Groq key by default). Without it the
# fallback is off and Listen works only where the browser transcribes. Never use NEXT_PUBLIC_.
DIT_TRANSCRIBE_API_KEY=
# Optional OpenAI-compatible speech endpoint. Default: https://api.groq.com/openai/v1
DIT_TRANSCRIBE_BASE_URL=
# Optional speech model. Default: whisper-large-v3-turbo
DIT_TRANSCRIBE_MODEL=
