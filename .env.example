# Optional and server-only. Without a key, /api/expand answers 503 and the app uses the on-device expander.
DIT_LLM_API_KEY=
# Optional OpenAI-compatible base URL. Default: https://api.fireworks.ai/inference/v1
DIT_LLM_BASE_URL=
# Optional model ID. Default: DEFAULT_MODEL in src/lib/expansion/provider.ts
DIT_MODEL=
