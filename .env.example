# Optional and server-only. Without a key, /api/expand answers 503 and the app uses the on-device expander.
DIT_LLM_API_KEY=
# Optional OpenAI-compatible base URL. Default: https://api.fireworks.ai/inference/v1
DIT_LLM_BASE_URL=
# Optional model ID. Default: DEFAULT_MODEL in src/lib/expansion/provider.ts
DIT_MODEL=

# Optional server-only speech key; defaults to DIT_LLM_API_KEY for the legacy Fireworks endpoint.
# A different provider needs its own key here; never use a NEXT_PUBLIC_ variable.
DIT_TRANSCRIBE_API_KEY=
# Legacy default: https://audio-prod.api.fireworks.ai/v1 (deprecated; live check returns 401).
# Recommended active alternative: https://api.groq.com/openai/v1 (requires a Groq key).
DIT_TRANSCRIBE_BASE_URL=
# Legacy default: whisper-v3-turbo. For Groq use whisper-large-v3-turbo.
DIT_TRANSCRIBE_MODEL=
