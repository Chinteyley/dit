# dependencies
node_modules/

# next.js (next-env.d.ts is regenerated by next dev, next build and next typegen)
.next/
next-env.d.ts

# typescript incremental build info
*.tsbuildinfo

# env files (document variables in .env.example instead)
.env*
!.env.example

# scratch directory for test and script temp files
.tmp/

# MediaPipe WebAssembly, copied from node_modules by scripts/mediapipe-assets.ts on install
public/mediapipe/*/wasm/

# os
.DS_Store
